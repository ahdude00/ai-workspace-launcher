<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests that need Windows (SQLite, registry under HKCU\Software\AWL.Tests, …) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AWL.Infrastructure\AWL.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fixtures/ClaudeProcess/ClaudeProcess.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyClaudeFixture" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="../Fixtures/ClaudeProcess/bin/$(Configuration)/net10.0/claude*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)ClaudeFixture" />
  </Target>
</Project>
