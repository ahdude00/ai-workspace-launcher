<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that touches Windows: SQLite, processes, registry, uv, logging -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AWL.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AWL.Infrastructure.Tests" />
    <ProjectReference Include="..\AWL.Core\AWL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Python/Assets/requirements.lock;Python/Assets/check_environment.py"
          Link="Assets/Python/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
