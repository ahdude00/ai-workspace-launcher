<Window x:Class="AWL.Desktop.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="#3C3C3C" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,5" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20">
    <Label Content="{StaticResource T.TitleLabel}" Target="{Binding ElementName=TitleBox}" />
    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
             AutomationProperties.Name="{StaticResource T.TitleLabel}" />

    <Label Content="{StaticResource T.FolderPickerLabel}" Target="{Binding ElementName=FolderBox}" Margin="0,16,0,0" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{StaticResource T.BrowseButton}" Command="{Binding BrowseCommand}"
              Padding="12,5" Margin="8,0,0,0" IsEnabled="{Binding IsNew}" />
      <TextBox x:Name="FolderBox" Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}"
               IsReadOnly="{Binding IsFolderReadOnly, Mode=OneTime}"
               AutomationProperties.Name="{StaticResource T.FolderPickerLabel}" />
    </DockPanel>

    <Label Content="{StaticResource T.CategoryLabel}" Target="{Binding ElementName=CategoryBox}" Margin="0,16,0,0" />
    <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
              DisplayMemberPath="Name" Padding="6,5"
              AutomationProperties.Name="{StaticResource T.CategoryLabel}" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,16,0,0"
               AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" IsDefault="True"
              Padding="16,7" MinWidth="110" Margin="0,0,8,0" />
      <Button Content="{StaticResource T.CancelButton}" IsCancel="True"
              Padding="16,7" MinWidth="96" />
    </StackPanel>
  </StackPanel>
</Window>
