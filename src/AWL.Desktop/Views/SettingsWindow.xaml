<Window x:Class="AWL.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource T.SettingsTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=RetentionBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#595959" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,12,24,20">
    <TextBlock Text="{StaticResource T.SettingsHistoryGroup}" Style="{StaticResource Group}" />
    <Label Padding="0,0,0,4" Content="{StaticResource T.SettingsRetentionLabel}" Target="{Binding ElementName=RetentionBox}" />
    <StackPanel Orientation="Horizontal">
      <TextBox x:Name="RetentionBox" Width="90" Padding="6,5" MaxLength="5"
               Text="{Binding RetentionText, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{StaticResource T.SettingsRetentionLabel}" />
      <TextBlock Text="{StaticResource T.SettingsDays}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
    <TextBlock Text="{StaticResource T.SettingsRetentionHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />

    <TextBlock Text="{StaticResource T.SettingsTerminalGroup}" Style="{StaticResource Group}" />
    <RadioButton Content="{StaticResource T.SettingsWindowsTerminal}" IsChecked="{Binding UseWindowsTerminal}"
                 GroupName="Terminal" Margin="0,0,0,6" />
    <RadioButton Content="{StaticResource T.SettingsWindowsConsole}" IsChecked="{Binding UseConsole}" GroupName="Terminal" />
    <TextBlock Text="{StaticResource T.SettingsTerminalHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,16,0,0"
               AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{StaticResource T.SaveButton}" Command="{Binding SaveCommand}" IsDefault="True"
              Padding="16,7" MinWidth="96" Margin="0,0,8,0" />
      <Button Content="{StaticResource T.CancelButton}" IsCancel="True" Padding="16,7" MinWidth="96" />
    </StackPanel>

    <Separator Margin="0,20,0,0" />
    <TextBlock Text="{StaticResource T.SettingsSupportGroup}" Style="{StaticResource Group}" />
    <TextBlock Text="{StaticResource T.SettingsRepairHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
    <WrapPanel>
      <Button Content="{StaticResource T.RepairButton}" Command="{Binding RepairCommand}" Padding="14,7" Margin="0,0,8,8" />
      <Button Content="{StaticResource T.SaveDiagnosticsButton}" Command="{Binding SaveDiagnosticsCommand}"
              Padding="14,7" Margin="0,0,8,8" />
      <Button Content="{StaticResource T.AboutButton}" Command="{Binding ShowAboutCommand}" Padding="14,7" Margin="0,0,8,8" />
    </WrapPanel>
  </StackPanel>
</Window>
