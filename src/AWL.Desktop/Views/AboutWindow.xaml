<Window x:Class="AWL.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource T.AboutTitle}"
        Width="640" Height="560" MinWidth="480" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontSize="14" UseLayoutRounding="True">
  <DockPanel Margin="24,20">
    <TextBlock DockPanel.Dock="Top" Text="{StaticResource T.MainWindowTitle}" FontSize="22" FontWeight="SemiBold" />

    <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="AWL" Margin="0,0,24,6" Foreground="#595959" />
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AwlVersion, Mode=OneWay}" IsReadOnly="True"
               BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,6" />
      <TextBlock Grid.Row="1" Text="Claude Code" Margin="0,0,24,6" Foreground="#595959" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClaudeVersion, Mode=OneWay}" IsReadOnly="True"
               BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,6" />
      <TextBlock Grid.Row="2" Text="Python" Margin="0,0,24,6" Foreground="#595959" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PythonVersion, Mode=OneWay}" IsReadOnly="True"
               BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,6" />
      <TextBlock Grid.Row="3" Text="Windows" Margin="0,0,24,0" Foreground="#595959" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WindowsVersion, Mode=OneWay}" IsReadOnly="True"
               BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" />
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{StaticResource T.SaveDiagnosticsButton}" Command="{Binding SaveDiagnosticsCommand}"
              Padding="14,7" Margin="0,0,8,0" />
      <Button Content="{StaticResource T.CloseButton}" IsCancel="True" Padding="14,7" MinWidth="96" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="{StaticResource T.ThirdPartyLicenses}" FontWeight="SemiBold" Margin="0,20,0,6" />
    <TextBox Text="{Binding Notices, Mode=OneTime}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             AutomationProperties.Name="{StaticResource T.ThirdPartyLicenses}" />
  </DockPanel>
</Window>
