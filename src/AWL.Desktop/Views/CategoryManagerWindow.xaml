<Window x:Class="AWL.Desktop.Views.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource T.CategoriesTitle}"
        Width="520" Height="480" MinWidth="420" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontSize="14" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{StaticResource T.CategoriesHint}" TextWrapping="Wrap"
               Foreground="#595959" Margin="0,0,0,12" />

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <Label DockPanel.Dock="Top" Padding="0,0,0,4" Content="{StaticResource T.CategoryNameLabel}"
             Target="{Binding ElementName=NameBox}" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{StaticResource T.AddCategoryButton}"
              Command="{Binding AddCommand}" IsDefault="True" />
      <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
               Padding="6,5" AutomationProperties.Name="{StaticResource T.CategoryNameLabel}" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap"
               Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive"
               Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="96"
            Content="{StaticResource T.CloseButton}" IsCancel="True" />

    <StackPanel DockPanel.Dock="Right" Margin="12,12,0,0" MinWidth="150">
      <Button Content="{StaticResource T.RenameCategoryButton}" Command="{Binding RenameCommand}" />
      <Button Content="{StaticResource T.MoveUpButton}" Command="{Binding MoveUpCommand}" />
      <Button Content="{StaticResource T.MoveDownButton}" Command="{Binding MoveDownCommand}" />
      <Button Content="{StaticResource T.DeleteCategoryButton}" Command="{Binding DeleteCommand}" />
    </StackPanel>

    <ListBox Margin="0,12,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
             DisplayMemberPath="Name" AutomationProperties.Name="{StaticResource T.CategoriesTitle}" />
  </DockPanel>
</Window>
