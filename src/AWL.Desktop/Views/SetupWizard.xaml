<UserControl x:Class="AWL.Desktop.Views.SetupWizard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel MaxWidth="600" Margin="24">
   <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Margin="0,6,0,16" x:Name="Description"/>
   <ProgressBar x:Name="Progress" Height="8"/>
   <StackPanel x:Name="Rows" Margin="0,14"/>
   <TextBlock x:Name="Message" TextWrapping="Wrap"/>
   <TextBox x:Name="Details" IsReadOnly="True" Visibility="Collapsed" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,8"/>
   <WrapPanel>
    <Button x:Name="ContinueButton" Padding="12,6" Margin="0,6,8,0" Visibility="Collapsed" Click="ContinueClick"/>
    <Button x:Name="Reopen" Padding="12,6" Margin="0,6,8,0" Visibility="Collapsed" Click="ReopenClick"/>
    <Button x:Name="Copy" Padding="12,6" Margin="0,6,0,0" Visibility="Collapsed" Click="CopyClick"/>
   </WrapPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
